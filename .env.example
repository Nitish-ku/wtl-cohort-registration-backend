# Copy to .env for local development. Cloud Run does not read this file, set these as
# real environment variables / secrets on the Cloud Run service instead.

# Local dev only: path to a downloaded Firebase/GCP service-account JSON key with Firestore
# access on the `wiredtolaunch` project. Not needed (and should NOT be set) on Cloud Run,
# where firebase-admin's applicationDefault() picks up the service account attached to the
# Cloud Run service itself instead. See src/services/firestore.js.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Standard Express port. Cloud Run injects its own PORT env var at deploy time; this is only
# used for local `npm start`.
PORT=8080

# Leave unset (or "development") locally so http://localhost:3000 / :5173 are allowed by CORS.
# Cloud Run deploy sets this to "production" via the Dockerfile's ENV NODE_ENV=production.
NODE_ENV=development
